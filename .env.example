# Copy this file to .env and fill in the values.
# .env is git-ignored and must never be committed.

# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=3
# Hard cap on tokens generated per reply (cost guard).
OPENAI_MAX_OUTPUT_TOKENS=512

# --- Database ---
# Inside docker-compose the host is "db". For a local run use localhost.
DATABASE_URL=postgresql+asyncpg://chat:chat@db:5432/chat

# --- Application ---
APP_ENV=local
LOG_LEVEL=INFO

# How many past messages are sent to the model as context (system prompt excluded).
CONTEXT_MAX_MESSAGES=20
# Refuse messages longer than this (characters).
MAX_MESSAGE_CHARS=8000
# Refuse sessions longer than this (guards a public demo against runaway cost).
MAX_MESSAGES_PER_SESSION=100

# --- Deployment only (docker-compose.prod.yml) ---
# Required by the production compose file, which has no fallback: it refuses to
# start rather than create a database with a guessable password. Generate one,
# for example: openssl rand -base64 24
POSTGRES_PASSWORD=

# --- Demo protection (optional) ---
# Leave empty for local development: auth is then disabled.
# Set to a random string on a public deployment - clients must send it as X-API-Key.
API_KEY=
